# Local development with the independently running mock IAM/configuration service.
# Copy to .env.local and adjust values there; never commit real credentials.
IAM_API_URL=http://localhost:5050
IAM_ISSUER=http://localhost:5050
SUBSCRIBER_ID=iam-chatbot-mfe-bff
SUBSCRIBER_SECRET=dev-only-secret
# Must match the exact MFE origin, including scheme, hostname, and port.
IDENTITY_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=iam_poc_session
# Keep blank for localhost; use a common parent domain for shared-domain deployments.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRANSACTION_STORE=memory
REDIS_URL=redis://localhost:6379

CLIENT_CONFIGURATION_URL=http://localhost:5050
